# The WebSocket URL is derived from the browser host when omitted.
# NEXT_PUBLIC_TELEMETRY_WS_URL=wss://your-project.vercel.app/api/ws

# Set this on Vercel and locally in the listener shell. It blocks untrusted telemetry publishers.
TELEMETRY_WRITE_KEY=replace-with-a-long-random-secret

# Public values from Supabase Project Connect. Set these in Vercel too.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
